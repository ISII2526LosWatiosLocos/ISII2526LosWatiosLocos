@page "/Compra/CrearCompra"

@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<CreateCompra> logger
@inject CompraStateContainer compraState

@attribute [Authorize]

<h3>CrearCompra</h3>

@* compra is the object that will be edited thanks to the form *@
<EditForm Model="compra" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
        <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
            <p id="ErrorsShown">Errors: @messageError</p>
        </div>
    </div>


    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Nombre" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Apellidos" class="form-control" id="Surname" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.DireccionEnvio" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>


    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@compra.MetodoPagoId" id="PaymentMethod">
                    <option value="@PaymentMethodType.CreditCard" default> CreditCard</option>
                    <option value="@PaymentMethodType.PayPal"> PayPal</option>
                    <option value="@PaymentMethodType.Cash"> Cash</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to comprar las herramientas*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Compra tus herramientas
                </button>
            </div>
        </div>
    </div>


    <h4>Rental detail</h4>
    <p>
        <b>Precio total:</b> @TotalCost €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyCompraItems" id="ModifyHerramientas">
            Modifica herramientas
        </button>
    </p>


    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfCompraItems">
            <thead>
                <tr>
                    <th>Material</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>DescripcionHerramienta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in compra.Items)
                {
                    <tr id="MovieData_@item.NombreHerramienta">
                        <td>@item.MaterialHerramienta</td>
                        <td>@item.CantidadHerramienta</td>
                        <td>@item.PrecioHerramienta</td>
                        <td><InputText @bind-Value="item.DescripcionHerramienta" class="form-control" id="@($"description_{item.IdHerramienta}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to buy*@
@if (DialogIsOpen)
{
    <Dialog Caption="Comprar herramientas"
    Message="¿Quieres proceder con tu compra?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {

    private string messageError = "";

    private bool hideErrors { get { return messageError.Length == 0; } }

    private bool DialogIsOpen;

    private decimal TotalCost
    {
        get
        {
            double price = compra.Items.Sum(i => i.PrecioHerramienta);
            return Convert.ToDecimal(price);
        }
    }
    private void ModifyRentalItems()
    {
        navigation.NavigateTo("/rental/selectmoviesforrental");
    }

    private CrearCompraDTO compra => compraState.Compra;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (compra.Items.Count > 0)
            {
                try
                {
                    var comprado = await apiclient.CrearCompraAsync(compra);
                    compraState.CompraProcesada();
                    navigation.NavigateTo($"/Compra/DetalleCompra/?CompraID={comprado.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }

            }
        }
    }

    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    compra.Nombre = user.Identity.Name;
                }
            }
            compra.Nombre = compra.Nombre == null ? "" : compra.Nombre;
            compra.Apellidos = compra.Apellidos == null ? "" : compra.Apellidos;
            compra.DireccionEnvio = compra.DireccionEnvio == null ? "" : compra.DireccionEnvio;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

}