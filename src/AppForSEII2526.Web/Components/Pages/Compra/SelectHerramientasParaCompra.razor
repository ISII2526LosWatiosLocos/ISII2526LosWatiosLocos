@page "/Compra/SelectHerramientasParaCompra"

@using AppForSEII2526.Web.API
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<SelectHerramientasParaCompra> logger
@inject CompraStateContainer compraState

<h3>Select Herramientas Para Compra</h3>
<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <p>here i will show the errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Title</span>
                        <input type="text" id="inputTitle" @bind=filtroMaterial class="form-control" placeholder="Material" aria-label="Material" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Genre</span>
                        <input type="text" id="inputGenre" @bind=filtroPrecio class="form-control" placeholder="Precio" aria-label="Precio" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHerramientas id="searchHerramientas">Search herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Loading herramientas....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfCompras">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th>Precio</th>
                                    <th>Compra</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramientas in herramientas)
                                {
                                    <tr nombre="HerramientaData_@herramientas.Nombre">
                                        <td>@herramientas.Material</td>
                                        <td>@herramientas.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" nombre="herramientaParaComprar_@herramientas.Nombre" @onclick="@(() => AñadirHerramienta(herramientas))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-2">
            <p>here i will show the compras cart</p>
        </div>
    </div>

</div>

@code {
    private ICollection<HerramientasParaComprarDTO> herramientas;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string filtroMaterial { get; set; }
    private float filtroPrecio { get; set; }
    private CrearCompraDTO compra => compraState.Compra;
    private bool hiddenRentingCart = true;
    private void AñadirHerramienta(HerramientasParaComprarDTO herramienta)
    {
        compraState.AñadirHerramientaAlCarroDeCompra(herramienta);
    }
    private void RemoveRentalItem(CompraItemsDTO item)
    {
        compraState.QuitarItemDelCarroDeCompra(item);
        if (compra.Items.Count == 0) hiddenRentingCart = true;
    }

    public async void BuscarHerramientas()
    {
        try
        {
            herramientas = await apiclient.GetHerramientasParaCompraAsync(filtroMaterial, filtroPrecio);
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();

    }

    protected override Task OnInitializedAsync()
    {

        BuscarHerramientas();
        return base.OnInitializedAsync();

    }

}
