@page "/Compra/SelectHerramientasParaCompra"

@using AppForSEII2526.Web.API
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<SelectHerramientasParaCompra> logger
@inject CompraStateContainer compraState
@inject NavigationManager navigation

<h3>Select Herramientas Para Compra</h3>
<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <p>here i will show the errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Material</span>
                        <input type="text" id="inputMaterial" @bind=filtroMaterial class="form-control" placeholder="Material" aria-label="Material" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Precio</span>
                        <input type="number" id="inputPrecio" @bind=filtroPrecio class="form-control" placeholder="Precio" aria-label="Precio" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHerramientas id="searchHerramientas">Search herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Loading herramientas....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfCompras">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th>Precio</th>
                                    <th>Compra</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramienta in herramientas)
                                {
                                    <tr id="HerramientaData_@herramienta.Nombre">
                                        <td>@herramienta.Material</td>
                                        <td>@herramienta.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaParaComprar_@herramienta.Nombre" @onclick="@(() => AñadirHerramienta(herramienta))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-2" hidden="@hideCompraCart">
            <div class="row">
                <h3>Shopping Cart</h3>
            </div>
            @foreach (CompraItemsDTO item in compra.Items)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="quitarHerramienta_@item.NombreHerramienta" @onclick="@(() => QuitarItemDelCarroDeCompra(item))">x @item.NombreHerramienta - @item.PrecioHerramienta€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="purchaseHerramientaButton" @onclick=@ComprarHerramientas>Comprar herramientas</button>
            </div>
        </div>
    </div>

</div>

@code {
    private bool hideCompraCart { get { return compra.Items.Count == 0; } }
    private ICollection<HerramientasParaComprarDTO> herramientas;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string filtroMaterial { get; set; }
    private float filtroPrecio { get; set; }
    private CrearCompraDTO compra => compraState.Compra;
    private bool hiddenCompraCart = true;
    private void AñadirHerramienta(HerramientasParaComprarDTO herramienta)
    {
        compraState.AñadirHerramientaAlCarroDeCompra(herramienta);
    }
    private void QuitarItemDelCarroDeCompra(CompraItemsDTO item)
    {
        compraState.QuitarItemDelCarroDeCompra(item);
        if (compra.Items.Count == 0) hiddenCompraCart = true;
    }

    public async void BuscarHerramientas()
    {
        try
        {
            herramientas = await apiclient.GetHerramientasParaCompraAsync(filtroMaterial, filtroPrecio);
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();

    }

    protected override Task OnInitializedAsync()
    {

        BuscarHerramientas();
        return base.OnInitializedAsync();

    }

    private void ComprarHerramientas()
    {
        navigation.NavigateTo("/Compra/CrearCompra");
    }

}
