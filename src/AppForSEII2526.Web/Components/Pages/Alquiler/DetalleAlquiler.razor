@page "/Alquiler/DetalleAlquiler"
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForHerramientasAPIClient apiclient

<h3>Detalle Alquiler</h3>

@attribute [Authorize]

@if (Alquiler == null)
{
    <p>@error</p>
}
else
{
}


@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int AlquilerId { get; set; }
    private AlquileresParaDetalleDTO Alquiler;
    private string error = "";

    [CascadingParameter]
    private Task<AuthenticationState>? autentificacion { get; set; }


    protected override async Task OnInitializedAsync()
    {
        // Comprobamos si el usuario inició sesión
        string nombre = "";
        if (autentificacion is not null)
        {
            var estado = await autentificacion;
            var usuario = estado?.User;

            // Cogemos el id del que inicio sesión
            if (usuario is not null)
            {
                if (usuario.Identity is not null && usuario.Identity.IsAuthenticated && usuario.IsInRole("User"))
                {
                    nombre = usuario.Identity.Name;
                }
            }
        }

        try
        {
            Alquiler = await apiclient.GetDetalleHerramientasParaAlquilerAsync(AlquilerId);
        }
        catch (ApiException exception)
        {
            Alquiler = null;
        }
        if ((Alquiler == null) || (Alquiler.Nombre != nombre))
        {
            error = $"Error! No tienes permiso para ver este alquiler o no hay alquiler con id={AlquilerId}";
        }


    }


}