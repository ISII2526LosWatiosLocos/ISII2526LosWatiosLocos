@page "/Alquiler/DetalleAlquiler"
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject ILogger<SeleccionarHerramientasParaAlquilar> logger
@inject AppForHerramientasAPIClient apiclient

<h3>Detalle Alquiler</h3>

<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <div class="alert alert-danger" role="alert">
            @errors
        </div>
    </div>

    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">IdAlquiler</span>
                        <input type="number" id="IdAlquiler" @bind="IdAlquiler" class="form-control" placeholder="IdAlquiler" aria-label="IdAlquiler">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick="BuscarAlquiler" id="searchAlquiler">Buscar alquiler</button>
                </div>
            </div>

            <div class="row">
                @if (isLoading)
                {
                    <p>Cargando alquiler...</p>
                }
                else if (alquiler != null)
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfAlquileres">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Dirección</th>
                                    <th>Fecha Alquiler</th>
                                    <th>Fecha Inicio</th>
                                    <th>Fecha Fin</th>
                                    <th>Precio total</th>
                                    <th>Items</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="align-middle">
                                    <td>@alquiler.Nombre @alquiler.Apellidos</td>
                                    <td>@alquiler.Direccion</td>
                                    <td>@alquiler.FechaAlquiler.ToString("dd/MM/yyyy")</td>
                                    <td>@alquiler.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@alquiler.FechaFinal.ToString("dd/MM/yyyy")</td>
                                    <td>@alquiler.PrecioTotal.ToString("C2")</td>
                                    <td style="min-width: 350px;">
                                        @if (alquiler.Items != null && alquiler.Items.Any())
                                        {
                                            <ul class="list-group list-group-flush">
                                                @foreach (var item in alquiler.Items)
                                                {
                                                    <li class="list-group-item p-2">
                                                        <div class="fw-bold text-primary">
                                                            @item.NombreItem
                                                        </div>
                                                        <div class="small text-muted mb-1">
                                                            @item.MaterialItem
                                                            |
                                                            @item.CantidadItem u.
                                                            |
                                                            @item.PrecioItem.ToString("2")
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No hay herramientas en este alquiler.</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
                else if (hasSearched)
                {
                    <p>No se encontraron resultados para este ID.</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // 2. CAPTURAMOS EL ID QUE VIENE POR LA URL
    [Parameter]
    [SupplyParameterFromQuery]
    public int? IdRecibido { get; set; }

    private AlquileresParaDetalleDTO? alquiler;
    private bool hideErrors => string.IsNullOrEmpty(errors);
    private string errors = "";
    private int IdAlquiler { get; set; } = 0;
    private bool isLoading = false;
    private bool hasSearched = false;

    // 3. AUTOMATIZACIÓN: Si recibimos un ID por URL, buscamos automáticamente
    protected override async Task OnParametersSetAsync()
    {
        if (IdRecibido.HasValue && IdRecibido.Value > 0)
        {
            // Asignamos el valor al input
            IdAlquiler = IdRecibido.Value;
            // Ejecutamos la búsqueda sin esperar click
            await BuscarAlquiler();
        }
    }

    public async Task BuscarAlquiler()
    {
        isLoading = true;
        errors = "";
        alquiler = null;
        hasSearched = true;

        try
        {
            if (IdAlquiler <= 0)
            {
                errors = "Por favor ingrese un ID válido";
                return;
            }

            alquiler = await apiclient.GetDetalleHerramientasParaAlquilerAsync(IdAlquiler);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error fetching rental details");
            errors = "Error al conectar con el sistema.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}