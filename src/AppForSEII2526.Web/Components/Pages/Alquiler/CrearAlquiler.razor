@page "/Alquiler/CrearAlquiler"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<CrearAlquiler> logger
@inject AlquilerStateContainer container
@inject NavigationManager navegacion
<h3>CrearAlquiler</h3>

@* rental is the object that will be edited thanks to the form *@
<EditForm Model="alquiler" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrores">
        <p id="ErrorsShown">Errores: @mensajeError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.Nombre" class="form-control" id="Name" />
                <label for="Name">Nombre </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.Apellidos" class="form-control" id="Surname" />
                <label for="Name">Apellidos </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.Direccion" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Direccción de envío </label>
            </div>
        </div>
    </div>
    <div class="row g-3">
            <div class="col-md">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="alquiler.Correo" class="form-control" id="Email" />
                    <label for="Email">Correo electrónico</label>
                </div>
            </div>
            <div class="col-md">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="alquiler.Telefono" class="form-control" id="Phone" />
                    <label for="Phone">Teléfono</label>
                </div>
            </div>
            <div class="col-md">
                <div class="form-floating mb-3">
                    <InputDate @bind-Value="alquiler.FechaInicio" class="form-control" id="InitialDate" />
                    <label for="InitialDate">Fecha inicial</label>
                </div>
            </div>
            <div class="col-md">
                <div class="form-floating mb-3">
                    <InputDate @bind-Value="alquiler.FechaFinal" class="form-control" id="FinalDate" />
                    <label for="FinalDate">Fecha final</label>
                </div>
            </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@alquiler.MetodoPagoId" id="PaymentMethod">
                    <option value=0> Efectivo</option>
                    <option value=1> PayPal</option>
                    <option value=2> Tarjeta</option>
                </InputSelect>
                <label for="PaymentMethod">Método de pago</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                @*este boton se usara para decir al usuario que si quiere alquilar las herramientas*@
                <button class="btn btn-primary" type="submit" id="Submit" disabled="@botonAlquilerApagado">
                    Alquila tus herramientas
                </button>
            </div>
        </div>
    </div>

    <hr/>

    <h4>Detalles del alquiler</h4>
    <p><b>Fecha desde:</b> @alquiler.FechaInicio.ToString("dd/MM/yyyy") <b>hasta:</b> @alquiler.FechaFinal.ToString("dd/MM/yyyy")</p>
    <p>
        <b>Precio total:</b> @precioTotal $
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyAlquilerlItems" id="ModifyHerramientas">
            Modificar herramientas
        </button>
    </p>


    <h4 class="mt-4">Detalle de Herramientas</h4>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfRentalItems">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Material</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in alquiler.Items)
                {   
                    <tr id="AlquilerData_@item.IdItem">
                        <td>@item.NombreItem</td>
                        <td>@item.MaterialItem</td>
                        <td>@item.PrecioItem $</td>
                        <td>
                            <div class="input-group input-group-sm">
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        @onclick="@(() => DisminuirCantidad(item))">
                                    -
                                </button>

                                <InputNumber @bind-Value="item.CantidadItem"
                                             class="form-control text-center"
                                             id="@($"cantidad_{item.IdItem}")"
                                             min="1" />

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        @onclick="@(() => AumentarCantidad(item))">
                                    +
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</EditForm>

@*a modal popup dialog for checking if user wants to proceed to rent*@
@if (DialogIsOpen)
{
    <Dialog Caption="Alquilar herramientas"
    Message="¿Desea proceder con el alquiler?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private bool botonAlquilerApagado
    {
        get
        {
            return alquiler.Items == null || alquiler.Items.Count == 0;
        }
    }
    private bool DialogIsOpen;
    private string mensajeError = "";
    private bool hideErrores { get { return mensajeError.Length == 0; } }
    private float precioTotal
    {
        get
        {
            float precio = alquiler.Items.Sum(r => r.PrecioItem * r.CantidadItem);
            return precio;
        }
    }
    private void ModifyAlquilerlItems()
    {
        navegacion.NavigateTo("/Alquiler/SeleccionarHerramientasParaAlquilar");
    }

    private CrearAlquilerDTO alquiler => container.Alquilar;
    private void OpenDialog()
        {
            DialogIsOpen = true;
        }


    private void AumentarCantidad(AlquilarItemsDTO item)
    {
        item.CantidadItem++;
        // Si necesitas actualizar el precio total
        StateHasChanged();
    }
    private void DisminuirCantidad(AlquilarItemsDTO item)
    {
        if (item.CantidadItem > 1)
        {
            item.CantidadItem--;
            StateHasChanged();
        }
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            if (alquiler.Items.Count > 0)
            {
                try
                {
                    var alquilado = await apiclient.CreateAlquilerAsync(alquiler);
                    container.AlquilerProcesado();
                    navegacion.NavigateTo($"/Alquiler/DetalleAlquiler/?IdRecibido={alquilado.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        mensajeError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            mensajeError = string.Join("(*) ", mensajeError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    mensajeError = "Error mientras se procesaba su solicitud, por favor prueba más tarde!";
                }
            }
        }
    }
}

