@page "/Alquiler/SeleccionarHerramientasParaAlquilar"

@using AppForSEII2526.Web.API
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<SeleccionarHerramientasParaAlquilar> logger
@inject AlquilerStateContainer alquilerState
@inject NavigationManager navegacion

<h3>SeleccionarHerramientasParaAlquilar</h3>
<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <p>Aquí mostraré los errores</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">NombreHerramienta</span>
                        <input type="text" id="inputNombreHeramienta" @bind=nombre class="form-control" placeholder="Nombre" aria-label="Title" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">MaterialHerramienta</span>
                        <input type="text" id="inputMaterialHerramienta" @bind=material class="form-control" placeholder="Material" aria-label="Genre" aria-describedby="basic-addon1">
                    </div>
                </div>
               
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHeramientas id="buscarHerramientas">Buscar herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Cargando herramientas...</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TablaDeHerramientas">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Material</th>
                                    <th>Fabricante</th>
                                    <th>Precio</th>
                                    <th>Alquilar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramienta in herramientas)
                                {
                                    <tr id="HerramientaData_@herramienta.Nombre">
                                        <td>@herramienta.Nombre</td>
                                        <td>@herramienta.Material</td>
                                        <td>@herramienta.Fabricante</td>
                                        <td>@herramienta.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaParaAlquilar_@herramienta.Nombre" @onclick="@(() => AddHerramienta(herramienta))">Añadir</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-2" hidden="@ocultarCarritoAlquiler">
            <div class="row">
                <h3>Carrito del Alquiler</h3>
            </div>
            @foreach (AlquilarItemsDTO item in alquiler.Items)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeMovie_@item.NombreItem" @onclick="@(() => BorrarHerramienta(item))">@item.NombreItem - @item.PrecioItem</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="btn_continuar_alquiler" @onclick=@AlquilarHerramientas>Alquilar Herramientas</button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool ocultarCarritoAlquiler { get { return alquiler.Items.Count == 0; } }
    private ICollection<HerramientasParaAlquilarDTO> herramientas;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string nombre { get; set; }
    private string material { get; set; }

    private CrearAlquilerDTO alquiler => alquilerState.Alquilar;

    private bool carritoAlquilerOculto = true;

    private void AddHerramienta(HerramientasParaAlquilarDTO herramienta)
    {
        alquilerState.AddHerramientaToAlquiler(herramienta);
    }

    private void BorrarHerramienta(AlquilarItemsDTO item)
    {
        alquilerState.BorraItemParaAlquilar(item);
        if (alquiler.Items.Count == 0) carritoAlquilerOculto = true;
    }

    private void AlquilarHerramientas()
    {
        navegacion.NavigateTo("/Alquiler/CrearAlquiler");
    }

    protected override async Task OnInitializedAsync()
    {
        // carga inicial automática
        await BuscarHeramientas();
    }

    private async Task BuscarHeramientas()
    {
        try
        {
            herramientas = await apiclient.GetHerramientasParaAlquilerAsync(nombre, material);
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error al conectarse al sistema";
        }
        StateHasChanged();
    }
}
