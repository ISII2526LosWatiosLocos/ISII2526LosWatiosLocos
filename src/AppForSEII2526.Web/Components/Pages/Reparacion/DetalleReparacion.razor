@page "/reparacion/getdetailsreparacion"
@using AppForSEII2526.Web.API
@inject AppForHerramientasAPIClient apiclient
@inject ILogger<SeleccionherramientaParaReparaciones> logger
@inject ReparacionStateContainer compraState

<PageTitle>Detalle de Reparación</PageTitle>

<h3>Factura simplificada</h3>

@if (_reparacion == null)
{
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    else
    {
        <p>Cargando detalles o introduce un ID...</p>
    }
}
else
{
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>Datos del Cliente y Reparación</strong>
        </div>
        <div class="card-body">
            <table class="table table-borderless table-sm">
                <tr>
                    <th style="width: 180px;">ID Reparación:</th>
                    <td id="IdReparacion">@_reparacion.Id</td>
                </tr>
                <tr>
                    <th>Cliente:</th>
                    @* OJO: Tu DTO usa minúsculas para nombre y apellidos *@
                    <td id="Name">@_reparacion.Nombre @_reparacion.Apellidos</td>
                </tr>
                <tr>
                    <th>Fecha Entrega:</th>
                    <td id="FechaEntrega">@_reparacion.FechaEntrega.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <th>Fecha Recogida:</th>
                    <td id="FechaRecogida">@_reparacion.FechaRecogida.ToString("dd/MM/yyyy")</td>
                </tr>
                @* NOTA: Teléfono y Método de Pago no están en tu ReparacionesDTO actual, por eso se omiten *@
            </table>
        </div>
    </div>

    <h4>Detalle de conceptos</h4>
    <table class="table table-striped table-hover mt-3 align-middle" id="HerramientasEnReparacion">
        <thead class="table-dark">
            <tr>
                @* El ID de herramienta no viene en el DTO de items del controlador, se quita *@
                <th scope="col">Herramienta</th>
                <th scope="col">Descripción / Problema</th>
                @* Fabricante y Tiempo no vienen en la proyección del controlador, se quitan *@
                <th scope="col" class="text-end">Precio Unit.</th>
                <th scope="col" class="text-center">Cant.</th>
                <th scope="col" class="text-end">Total Línea</th>
            </tr>
        </thead>
        <tbody>
            @if (_reparacion.ReparacionesItems != null && _reparacion.ReparacionesItems.Any())
            {
                @foreach (var item in _reparacion.ReparacionesItems)
                {
                    <tr>
                        <td>@item.HerramientaNombre</td>
                        <td>@item.HerramientaDescripcion</td>
                        <td class="text-end">@item.HerramientaPrecio.ToString("C")</td>
                        <td class="text-center">@item.HerramientaCantidad</td>
                        <td class="text-end fw-bold">
                            @* Calculamos el total de la línea en la vista *@
                            @((item.HerramientaPrecio * item.HerramientaCantidad).ToString("C"))
                        </td>
                    </tr>
                }
                <tr class="table-secondary border-top border-dark">
                    <td colspan="4" class="text-end fw-bold text-uppercase fs-5">Total Reparación:</td>
                    <td id="TotalCoste" class="text-end fw-bold text-primary fs-4">
                        @_reparacion.PrecioTotal.ToString("C")
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center p-3">
                        <span class="text-muted">No hay herramientas registradas en esta reparación.</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="container-fluid mt-5 pt-3 border-top">
    <div class="row">
        <div class="col-md-6">
            <h5>Buscar Otra Reparación</h5>
            <div class="input-group mb-3">
                <span class="input-group-text">ID</span>
                <input type="number" class="form-control" @bind="Id" placeholder="Ej. 1" />
                <button class="btn btn-primary" @onclick="CargarReparacion">Buscar</button>
            </div>
        </div>
    </div>
</div>

@code {
    private ReparacionesDTO? _reparacion; // Usamos tu DTO exacto
    private string error = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            await CargarReparacion();
        }
    }

    private async Task CargarReparacion()
    {
        try
        {
            // Tu controlador devuelve una lista: IEnumerable<ReparacionesDTO> o IList
            // Debemos tomar el primero.
            var listaResultados = await apiclient.GetDetalleHerramientasParaReparaciónAsync(Id);

            _reparacion = listaResultados.FirstOrDefault();

            if (_reparacion == null)
            {
                error = "Reparación no encontrada (ID no existe).";
            }
            else
            {
                error = "";
            }
        }
        catch (ApiException ex)
        {
            if (ex.StatusCode == 404) error = "Reparación no encontrada.";
            else error = $"Error API: {ex.Message}";
            _reparacion = null;
        }
        catch (Exception ex)
        {
            error = "Error de conexión o formato de datos.";
            Console.WriteLine(ex);
            _reparacion = null;
        }
    }
}