@page "/Ofertar/SeleccionarHerramientaParaOfertar"
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@inject AppForHerramientasAPIClient ApiClient
@inject ILogger<SeleccionarHerramientaParaOfertar> Logger
@inject OfertaStateContainer OfertaStateContainer
@inject NavigationManager navigation


<h3>Seleccionar Herramientas Para Ofertar</h3>

<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <p class="alert alert-danger">@errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Nombre Fabricante</span>
                        <select class="form-select" aria-label="Default select" @bind="fabricanteSelected" id="fabricanteSelected">
                            <option value="All" selected>All</option>
                            @if (fabricantes != null)
                            {
                                @foreach (string fabricanteNombre in fabricantes)
                                {
                                    <option value="@fabricanteNombre" id="fabricanteSelected_@fabricanteNombre">@fabricanteNombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Precio</span>
                        <input type="number" id="inputPrecio" @bind=precio class="form-control" placeholder="Precio" aria-label="Precio" aria-describedby="basic-addon1">
                    </div>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHerramientas id="buscarHerramientas">Buscar Herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Loading herramientas....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfOferta">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Material</th>
                                    <th>Fabricante</th>
                                    <th>Precio</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var her in herramientas)
                                {
                                    <tr id="row_@her.Nombre">
                                        <td>@her.Nombre</td>
                                        <td>@her.Material</td>
                                        <td>@her.Fabricante</td>
                                        <td>@her.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary"
                                                    id="btn_add_@her.Nombre"
                                                    @onclick="@(() => AddHerramienta(her))">
                                                Add
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>

        <div class="col-4">
            <div class="col-12" hidden="@hideRentingCart">
                <div class="row">
                    <h3>Carrito de Ofertas</h3>
                </div>
                <div class="row mb-3">
                    <p>Total: @OfertaStateContainer.PrecioFinal.ToString("C")</p>
                </div>
                @foreach (OfertaItemsDTO item in OfertaStateContainer.Oferta.Items) 
                {
                    <div class="row mb-1">
                        <button type="button" class="btn btn-light" id="removeHerramienta_@item.NombreHerramienta" @onclick="@(() => RemoveHerramientaItem(item))">
                            <span class="oi oi-trash"></span> @item.NombreHerramienta - @item.PrecioHerramienta€
                        </button>
                    </div>
                }
                <div class="row mt-3">
                    <button type="button" class="btn btn-success"
                            id="btn_continuar_oferta"
                            @onclick=@ofertarHerramientas
                            disabled="@(oferta.Items.Count == 0)">
                        Continuar a Crear Oferta
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@code {

    private string fabricanteSelected = "All";
    private ICollection<string>? fabricantes = new List<string>();
    // Propiedad computada que usa el estado del contenedor
    private bool hideRentingCart => OfertaStateContainer.Oferta.Items.Count == 0;
    private ICollection<HerramientasParaOfertarDTO>? herramientas;
    private bool hideErrors => string.IsNullOrEmpty(errors); 
    private string errors = "";
    private float? precio;

    private CrearOfertaDTO oferta => OfertaStateContainer.Oferta;

    protected override async Task OnInitializedAsync()
    {
        OfertaStateContainer.OnChange += StateHasChanged;

        try
        {
            fabricantes = await ApiClient.GetFabricantesAsync(null);
        }
        catch (ApiException ex)
        {
            Logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }

        await BuscarHerramientas();
    }

    public void Dispose()
    {
        OfertaStateContainer.OnChange -= StateHasChanged;
    }


    public async Task BuscarHerramientas()
    {

        string? nombreFabricante = fabricanteSelected == "All" ? null : fabricanteSelected;

        float? precioFiltro = precio is 0 ? null : precio;

        try
        {
            herramientas = await ApiClient.GetHerramientasParaOfertaAsync(nombreFabricante, precioFiltro);

        }
        catch (ApiException ex)
        {
            Logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
    }


    private void AddHerramienta(HerramientasParaOfertarDTO herramienta)
    {
        OfertaStateContainer.AddHerramientaToOferta(herramienta);
    }

    private void RemoveHerramientaItem(OfertaItemsDTO item)
    {
        OfertaStateContainer.RemoveOfertaItem(item);
    }

    private void ofertarHerramientas()
    {
        // Se asegura que la ruta sea correcta
        navigation.NavigateTo("/Ofertar/CrearOferta");
    }
}