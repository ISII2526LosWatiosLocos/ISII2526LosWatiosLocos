@page "/Ofertar/SeleccionarHerramientaParaOfertar"

@using AppForSEII2526.Web.API
@inject AppForHerramientasAPIClient ApiClient
@inject ILogger<SeleccionarHerramientaParaOfertar> Logger
@inject OfertaStateContainer OfertaStateContainer

<h3>Seleccionar Herramientas Para Ofertar</h3>

<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <p>Aquí voy a mostrar los errores</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Nombre Fabricante</span>
                        <input type="text" id="inputTitle" @bind=nombreFabricante class="form-control" placeholder="Title" aria-label="Title" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Precio</span>
                        <input type="text" id="inputGenre" @bind=precio class="form-control" placeholder="Genre" aria-label="Genre" aria-describedby="basic-addon1">
                    </div>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHerramientas id="buscarHerramientas">Buscar Herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (herramienta == null)
                {
                    <p>Loading herramientas....</p>
                }
                else
                {
                    <p>Numero de herramientas @herramienta.Count</p>

                }
            </div>
        </div>
        <div class="col-2">
            <p>Aquí voy a mostrar el carrito de ofertas</p>
        </div>

    </div>

</div>

@code {
    private ICollection<HerramientasParaOfertarDTO> herramienta;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string nombreFabricante { get; set; }
    private float precio { get; set; }


    public async void BuscarHerramientas()
    {
        try
        {
            herramienta = await ApiClient.GetHerramientasParaOfertaAsync(nombreFabricante, precio);

        }
        catch (ApiException ex)
        {
            Logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    protected override Task OnInitializedAsync()
    {
        

        BuscarHerramientas();

        return base.OnInitializedAsync();
    }

    private CrearOfertaDTO oferta => OfertaStateContainer.Oferta;

    private bool hiddenRentingCart = true;

    private void AddHerramienta(HerramientasParaOfertarDTO herramienta)
    {
        OfertaStateContainer.AddHerramientaToOferta(herramienta);
    }

    private void RemoveHerramientaItem(OfertaItemViewModel item)
    {
        OfertaStateContainer.RemoveOfertaItem(item);
        if (oferta.Items.Count == 0) hiddenRentingCart = true;
    }
}